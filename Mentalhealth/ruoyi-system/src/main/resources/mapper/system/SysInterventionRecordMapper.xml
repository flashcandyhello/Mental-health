<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysInterventionRecordMapper">
    
    <resultMap type="SysInterventionRecord" id="SysInterventionRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="studentName"    column="student_name"    />
        <result property="riskLevel"    column="risk_level"    />
        <result property="aiSuggestion"    column="ai_suggestion"    />
        <result property="handlerName"    column="handler_name"    />
        <result property="content"    column="content"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectSysInterventionRecordVo">
        select record_id, student_name, risk_level, ai_suggestion, handler_name, content, status, create_time from sys_intervention_record
    </sql>

    <select id="selectSysInterventionRecordList" parameterType="SysInterventionRecord" resultMap="SysInterventionRecordResult">
        <include refid="selectSysInterventionRecordVo"/>
        <where>  
            <if test="studentName != null  and studentName != ''"> and student_name like concat('%', #{studentName}, '%')</if>
            <if test="riskLevel != null  and riskLevel != ''"> and risk_level = #{riskLevel}</if>
            <if test="aiSuggestion != null  and aiSuggestion != ''"> and ai_suggestion = #{aiSuggestion}</if>
            <if test="handlerName != null  and handlerName != ''"> and handler_name like concat('%', #{handlerName}, '%')</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectSysInterventionRecordByRecordId" parameterType="Long" resultMap="SysInterventionRecordResult">
        <include refid="selectSysInterventionRecordVo"/>
        where record_id = #{recordId}
    </select>

    <insert id="insertSysInterventionRecord" parameterType="SysInterventionRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into sys_intervention_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="riskLevel != null">risk_level,</if>
            <if test="aiSuggestion != null">ai_suggestion,</if>
            <if test="handlerName != null">handler_name,</if>
            <if test="content != null">content,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="riskLevel != null">#{riskLevel},</if>
            <if test="aiSuggestion != null">#{aiSuggestion},</if>
            <if test="handlerName != null">#{handlerName},</if>
            <if test="content != null">#{content},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateSysInterventionRecord" parameterType="SysInterventionRecord">
        update sys_intervention_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="riskLevel != null">risk_level = #{riskLevel},</if>
            <if test="aiSuggestion != null">ai_suggestion = #{aiSuggestion},</if>
            <if test="handlerName != null">handler_name = #{handlerName},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteSysInterventionRecordByRecordId" parameterType="Long">
        delete from sys_intervention_record where record_id = #{recordId}
    </delete>

    <delete id="deleteSysInterventionRecordByRecordIds" parameterType="String">
        delete from sys_intervention_record where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>
</mapper>